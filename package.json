{
  "name": "wowgear",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "data:build": "pnpm --filter @wowgear/data build:db",
    "score": "pnpm --filter @wowgear/core score",
    "ui:dev": "pnpm --filter @wowgear/ui dev",
    "ui:build": "pnpm --filter @wowgear/ui build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
